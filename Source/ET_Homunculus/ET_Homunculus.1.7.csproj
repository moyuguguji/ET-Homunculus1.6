<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ET_Homunculus</AssemblyName>
    <RootNamespace>ET_Homunculus</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- RimWorld 1.7 (Waylith/CoreCLR) assembly goes into the 1.7/ version folder. -->
    <OutputPath>..\..\1.7\Assemblies</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
  </ItemGroup>

  <!--
    RimWorld 1.7 is a CoreCLR/Waylith build: game assemblies live in the install ROOT
    (RimWorldWin64_Data\Managed no longer exists) and the whole UnityEngine surface is
    replaced by the single UnityStubs.dll compatibility assembly.

    This assembly MUST NOT be used in 1.6: loading it there (Mono, UnityEngine split into
    modules) throws "VTable setup of type ET_Homunculus.HomunculusMod failed" and the
    whole settings page silently disappears. 1.6 uses ET_Homunculus.1.6.csproj instead.
  -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">G:\steam\steamapps\common\RimWorld</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
