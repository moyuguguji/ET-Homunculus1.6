  <!-- ================ ET.Impact ================ -->
  <ThingDef ParentName="HO_ImplantETBase">
    <defName>ET_HO_Ex_Impact</defName>
    <label>ET.Impact</label>
    <description>Expansion module for Nymph and Oread\n\nLong range ballistic bombing.</description>
    <graphicData>
      <texPath>Things/Pawn/Animal/Apparel/HO_Ex_weapon2_module</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>20000</WorkToMake>
    </statBases>
    <tickerType>Normal</tickerType>
    <verbs>
      <li>
        <label>ET.Impact</label>
        <verbClass>Verb_Shoot</verbClass>
        <accuracyTouch>2.0</accuracyTouch>
        <accuracyShort>2.0</accuracyShort>
        <accuracyMedium>2.0</accuracyMedium>
        <accuracyLong>2.0</accuracyLong>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ETImpact</defaultProjectile>
        <warmupTime>4</warmupTime>
        <ai_AvoidFriendlyFireRadius>5</ai_AvoidFriendlyFireRadius>
        <forcedMissRadius>18.9</forcedMissRadius>
        <minRange>18.9</minRange>
        <range>69.9</range>
        <ticksBetweenBurstShots>2.5</ticksBetweenBurstShots>
        <burstShotCount>1</burstShotCount>
        <soundAiming>PsycastCastLoop</soundAiming>
        <soundCast>InfernoCannon_Fire</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <onlyManualCast>true</onlyManualCast>
        <stopBurstWithoutLos>false</stopBurstWithoutLos>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
        </targetParams>
        <muzzleFlashScale>24</muzzleFlashScale>
        <rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
        <li Class="CompProperties_Usable">
          <useJob>UseItem</useJob>
          <useLabel>Install {0_label}</useLabel>
          <useDuration>120</useDuration>
        </li>
        <li Class="ET_Homunculus.CompProperties_UseEffectAddHediff">
          <hediffDef>HO_ET_Ability_Impact</hediffDef>
          <allowedRaces><li>Nymph</li><li>Oread</li></allowedRaces>
        </li>
        <li Class="CompProperties_UseEffectPlaySound">
          <soundOnUsed>PsyAmpInstalled</soundOnUsed>
        </li>
        <li Class="CompProperties_UseEffectDestroySelf" />
        <li Class="MVCF.Comps.CompProperties_VerbGiver">
          <verbProps>
            <li>
              <label>ET.Impact</label>
              <visualLabel>ET.Impact</visualLabel>
              <canBeToggled>true</canBeToggled>
              <description>long range ballistic bombing\nrecast/14h</description>
              <comps>
                <li Class="MVCF.VerbComps.VerbCompProperties_Cooldown">
                  <compClass>MVCF.VerbComps.VerbComp_Cooldown</compClass>
                  <cooldownTime>600</cooldownTime>
                </li>
              </comps>
            </li>
          </verbProps>
        </li>
    </comps>
    <costList>
      <ET_i_polymer>10</ET_i_polymer>
      <Chemfuel>150</Chemfuel>
    </costList>
    <recipeMaker>
      <displayPriority>4210</displayPriority>
    </recipeMaker>
  </ThingDef>

