        <useJob>UseItem</useJob>
        <useLabel>Install {0_label}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="ET_Homunculus.CompProperties_UseEffectAddHediff">
        <hediffDef>HO_CT_Unity</hediffDef>
        <allowedRaces><li>Nymph</li><li>Oread</li><li>Naiad</li></allowedRaces>
        <replacesHediffs><li>HO_CT_Protect</li><li>HO_CT_Haste</li><li>HO_CT_Maneuver</li><li>HO_CT_Jump</li></replacesHediffs>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>PsyAmpInstalled</soundOnUsed>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
    <costList>
      <ET_i_polymer>10</ET_i_polymer>
      <ET_Liquid_Ether_WET>1</ET_Liquid_Ether_WET>
      <ET_HO_N_protect>1</ET_HO_N_protect>
      <ET_HO_N_speed>1</ET_HO_N_speed>
      <ET_HO_N_maneuver>1</ET_HO_N_maneuver>
      <ET_HO_N_jump>1</ET_HO_N_jump>
  </costList>
    <recipeMaker>
      <skillRequirements>
        <Intellectual>15</Intellectual>
      </skillRequirements>
      <displayPriority>5200</displayPriority>
    </recipeMaker>
  </ThingDef>
  
