  <!-- ================ Protect ================ -->
  <ThingDef ParentName="HO_ImplantCTBase">
    <defName>ET_HO_N_protect</defName>
    <label>CT.Protect</label>
    <description>Plugin module for homunculus\nArmor plus</description>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Install {0_label}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="ET_Homunculus.CompProperties_UseEffectAddHediff">
        <hediffDef>HO_CT_Protect</hediffDef>
        <allowedRaces><li>Nymph</li><li>Oread</li><li>Naiad</li></allowedRaces>
        <blockedByHediffs><li>HO_CT_Unity</li></blockedByHediffs>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>PsyAmpInstalled</soundOnUsed>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
    <equippedStatOffsets>
      <ArmorRating_Blunt>+0.20</ArmorRating_Blunt>
      <ArmorRating_Sharp>+0.20</ArmorRating_Sharp>
      <ArmorRating_Heat>+0.20</ArmorRating_Heat>
    </equippedStatOffsets>
    <costList>
      <ET_i_polymer>4</ET_i_polymer>
      <ET_Liquid_Ether>1</ET_Liquid_Ether>
    </costList>
    <recipeMaker>
      <displayPriority>5010</displayPriority>
    </recipeMaker>
  </ThingDef>
  
