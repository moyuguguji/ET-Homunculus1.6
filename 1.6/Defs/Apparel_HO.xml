    <defName>ET_HO_N_Unity</defName>
    <label>CT.Unity</label>
    <description>Plugin module for homunculus\n\nStrengthening physical\nAbility: Jump</description>
    <graphicData>
      <texPath>Things/Pawn/Animal/Apparel/D_moduleB</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <comps>
