  <!-- ================ Jump ================ -->
  <ThingDef ParentName="HO_ImplantCTBase">
    <defName>ET_HO_N_jump</defName>
    <label>CT.Jump</label>
    <description>Plugin module for homunculus\n\nAbility: Jump</description>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Install {0_label}</useLabel>
        <useDuration>120</useDuration>
      </li>
      <li Class="ET_Homunculus.CompProperties_UseEffectAddHediff">
        <hediffDef>HO_CT_Jump</hediffDef>
        <allowedRaces><li>Nymph</li><li>Oread</li><li>Naiad</li></allowedRaces>
        <blockedByHediffs><li>HO_CT_Unity</li></blockedByHediffs>
      </li>
      <li Class="CompProperties_UseEffectPlaySound">
        <soundOnUsed>PsyAmpInstalled</soundOnUsed>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
    <statBases>
      <JumpRange>28</JumpRange>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Jump</verbClass>
        <label>jump</label>
        <violent>false</violent>
        <hasStandardCommand>true</hasStandardCommand>
        <onlyManualCast>True</onlyManualCast>
        <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
        <range>28</range>
        <warmupTime>1.2</warmupTime>
        <warmupEffecter>JumpWarmupEffect</warmupEffecter>
        <requireLineOfSight>true</requireLineOfSight>
        <mustCastOnOpenGround>true</mustCastOnOpenGround>
        <flightEffecterDef>JumpFlightEffect</flightEffecterDef>
        <soundLanding>JumpPackLand</soundLanding>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetPawns>false</canTargetPawns>
          <canTargetBuildings>false</canTargetBuildings>
        </targetParams>
      </li>
    </verbs>
    <comps>
      <li Class="MVCF.Comps.CompProperties_VerbGiver">
        <verbProps>
          <li>
            <label>jump</label>
            <visualLabel>jump</visualLabel>
            <canBeToggled>true</canBeToggled>
            <description>jumping move\nrecast/0.4h</description>
            <comps>
              <li Class="MVCF.VerbComps.VerbCompProperties_Cooldown">
                <compClass>MVCF.VerbComps.VerbComp_Cooldown</compClass>
                <cooldownTime>20</cooldownTime>
              </li>
            </comps>
          </li>
        </verbProps>
      </li>
    </comps>
    <costList>
      <ET_i_polymer>4</ET_i_polymer>
      <Chemfuel>50</Chemfuel>
    </costList>
    <recipeMaker>
      <displayPriority>5040</displayPriority>
    </recipeMaker>
  </ThingDef>

  <!-- ================ Unity | 合一(植入物) ================ -->
  <!-- 替换Protect+Haste+Maneuver+Jump / 消耗四个子模块合成 -->
