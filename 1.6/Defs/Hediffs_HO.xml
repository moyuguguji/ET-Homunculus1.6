  <!-- ==================== ET Module | 扩展插件 ==================== -->

  <!-- 钝+0.25 利+0.25 热+0.10 速+0.5 命+0.15 闪+0.10 / 再生:50/天 / Nymph可用 -->
  <HediffDef>
    <defName>HO_ET_Regen</defName>
    <label>ET.Regen</label>
    <labelNoun>an ET.Regen implant</labelNoun>
    <description>An installed ET.Regen module.\n\nEffects:\n  Blunt armor +25%\n  Sharp armor +25%\n  Heat armor +10%\n  Move speed +0.5 c/s\n  Melee hit chance +15%\n  Melee dodge chance +10%\n  Auto-regeneration (every 20 ticks)</description>
    <defaultLabelColor>(160,200,180)</defaultLabelColor>
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
          <ArmorRating_Heat>0.10</ArmorRating_Heat>
          <MoveSpeed>0.5</MoveSpeed>
          <MeleeHitChance>0.15</MeleeHitChance>
          <MeleeDodgeChance>0.10</MeleeDodgeChance>
        </statOffsets>
        <regeneration>200</regeneration>   <!-- 每天恢复200点伤害(Anomaly原版再生) -->
      </li>
    </stages>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <!-- ==================== AT Modules | 装甲层 ==================== -->

  <!-- Lv1: 钝+0.10 利+0.10 / 贴图:HO_BaseArmor / 被Armor和ArmorII封锁 -->
  <HediffDef>
    <defName>HO_AT_Frame</defName>
    <label>AT.Frame</label>
    <labelNoun>an AT.Frame implant</labelNoun>
    <description>An installed AT.Frame.\n\nEffects:\n  Blunt armor +10%\n  Sharp armor +10%</description>
    <defaultLabelColor>(150,150,170)</defaultLabelColor>
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
        </statOffsets>
      </li>
    </stages>
    <!--
      Cosmetic armour overlay (1.7): HediffDef-driven render node. RimWorld creates the
      node for every pawn carrying this hediff, so no PawnRenderTreeDef patch is needed.
      The node resolves the real texture as "<texPath>_<pawn.def.defName>" and is
      toggled per layer / per race from the mod settings ("hidden clothing").
    -->
    <renderNodeProperties>
      <li>
        <debugLabel>HO AT.Frame overlay</debugLabel>
        <nodeClass>ET_Homunculus.PawnRenderNode_HomunculusOverlay</nodeClass>
        <parentTagDef>Body</parentTagDef>
        <texPath>Things/Pawn/Animal/Apparel/HO_BaseArmor/HObasearmor</texPath>
        <drawSize>1.2</drawSize>
        <baseLayer>7</baseLayer>
        <pawnType>Any</pawnType>
      </li>
    </renderNodeProperties>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <!-- Lv2: 钝+0.25 利+0.25 热+0.50 / 贴图:HO_Armor / 替换Frame / 被ArmorII封锁 -->
