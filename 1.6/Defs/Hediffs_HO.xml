    <defName>HO_CT_Haste</defName>
    <label>CT.Haste</label>
    <labelNoun>a CT.Haste implant</labelNoun>
    <description>An installed CT.Haste module.\n\nEffects:\n  Move speed +2.0 c/s</description>
    <defaultLabelColor>(120,180,200)</defaultLabelColor>
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>2</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

