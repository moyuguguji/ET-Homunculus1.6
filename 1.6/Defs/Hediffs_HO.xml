    <defaultLabelColor>(150,150,170)</defaultLabelColor>
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
          <ArmorRating_Heat>0.5</ArmorRating_Heat>
        </statOffsets>
      </li>
    </stages>
    <renderNodeProperties>
      <li>
        <debugLabel>HO AT.Armor overlay</debugLabel>
        <nodeClass>ET_Homunculus.PawnRenderNode_HomunculusOverlay</nodeClass>
        <parentTagDef>Body</parentTagDef>
        <texPath>Things/Pawn/Animal/Apparel/HO_Armor/HOarmor</texPath>
        <drawSize>1.2</drawSize>
        <baseLayer>7</baseLayer>
        <pawnType>Any</pawnType>
      </li>
    </renderNodeProperties>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <!-- Lv3: 钝+0.65 利+0.65 热+1.20 / 贴图:HO_ArmorAD / 替换Frame+Armor / 最高级 -->
