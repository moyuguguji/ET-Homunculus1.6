<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ==================== CT Modules | 通用插件 ==================== -->

  <!-- 钝器+0.20 / 利器+0.20 / 热能+0.20 -->
  <HediffDef>
    <defName>HO_CT_Protect</defName>
    <label>CT.Protect</label>
    <labelNoun>a CT.Protect implant</labelNoun>
    <description>An installed CT.Protect module.\n\nEffects:\n  Blunt armor +20%\n  Sharp armor +20%\n  Heat armor +20%</description>
    <defaultLabelColor>(120,180,200)</defaultLabelColor>
    <isBad>false</isBad>
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
      <li>
        <statOffsets>
          <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
          <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
          <ArmorRating_Heat>0.20</ArmorRating_Heat>
        </statOffsets>
      </li>
    </stages>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <!-- 移速+2.0 c/s -->
