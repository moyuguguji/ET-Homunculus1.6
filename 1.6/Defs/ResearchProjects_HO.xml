<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 研究页签 -->
  <ResearchTabDef>
    <defName>ET</defName>
    <label>ET</label>
  </ResearchTabDef>

  <!-- Tier1 | 花费1000 | 前置:MultiAnalyzer -->
  <ResearchProjectDef>
    <defName>ET_BasicResearch</defName>
    <label>ET.Basic technology</label>
    <description>We will research basic technologies for access ET.matter</description>
    <tab>ET</tab>
    <prerequisites>
      <li>MultiAnalyzer</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>1000</baseCost>
    <techLevel>Ultra</techLevel>
    <researchViewX>0</researchViewX>
    <researchViewY>0</researchViewY>
  </ResearchProjectDef>

  <!-- Tier2 | 花费500 | 解锁homunculus生产 -->
  <ResearchProjectDef>
    <defName>ET_HomProduction</defName>
    <label>ET.Homunculus production</label>
    <description>Homunculus are manufactured by restoring and culturing archetype cells extracted from dryad.</description>
    <tab>ET</tab>
    <prerequisites>
      <li>ET_BasicResearch</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>500</baseCost>
    <techLevel>Ultra</techLevel>
    <researchViewX>1</researchViewX>
    <researchViewY>0</researchViewY>
  </ResearchProjectDef>

  <!-- Tier3 | 花费500 | 解锁药品 -->
  <ResearchProjectDef>
    <defName>ET_ReactionAnalysis</defName>
    <label>ET.Pharmacy</label>
    <description>We will research drugs that apply ET.technology</description>
    <tab>ET</tab>
    <prerequisites>
      <li>ET_HomProduction</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>500</baseCost>
    <techLevel>Ultra</techLevel>
    <researchViewX>2</researchViewX>
    <researchViewY>0</researchViewY>
  </ResearchProjectDef>

  <!-- Tier4 | 花费3000 | 解锁Psylink -->
  <ResearchProjectDef>
    <defName>ET_PSIPlusProduction</defName>
    <label>ET.Psylink</label>
    <description>experiment with the ET protocol to form a psylink.</description>
    <tab>ET</tab>
    <prerequisites>
      <li>ET_ReactionAnalysis</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>3000</baseCost>
    <techLevel>Ultra</techLevel>
    <researchViewX>3</researchViewX>
    <researchViewY>0</researchViewY>
  </ResearchProjectDef>

  <!-- 分支 | 花费200 | 解锁D型模块 -->
  <ResearchProjectDef>
    <defName>D_Dodule</defName>
    <label>D-Type module</label>
    <description>Development of expansion modules to improve performance of dryad.</description>
    <tab>ET</tab>
    <prerequisites>
      <li>ET_HomProduction</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>200</baseCost>
    <techLevel>Ultra</techLevel>
    <researchViewX>1</researchViewX>
    <researchViewY>1.40</researchViewY>
  </ResearchProjectDef>

  <!-- 分支 | 花费200 | 解锁CT模块 -->
  <ResearchProjectDef>
    <defName>CT_Module</defName>
    <label>CT.module</label>
    <description>Development of expansion modules to improve performance of archetype homunculus.</description>
    <tab>ET</tab>
    <prerequisites>
      <li>D_Dodule</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>200</baseCost>
    <techLevel>Ultra</techLevel>
    <researchViewX>2</researchViewX>
    <researchViewY>0.70</researchViewY>
  </ResearchProjectDef>

  <!-- 分支 | 花费200 | 解锁AT模块(装甲层) -->
  <ResearchProjectDef>
    <defName>AT_Module</defName>
    <label>AT.module</label>
    <description>Development of expansion module that strengthens physical resistance of archetype homunculus.</description>
    <tab>ET</tab>
    <prerequisites>
      <li>D_Dodule</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>200</baseCost>
    <techLevel>Ultra</techLevel>
    <researchViewX>2</researchViewX>
    <researchViewY>1.40</researchViewY>
  </ResearchProjectDef>

  <!-- 分支 | 花费200 | 解锁ET模块(武器/再生) -->
  <ResearchProjectDef>
    <defName>ET_Module</defName>
    <label>ET.module</label>
    <description>Development of expansion module that releases limiter of archetype homunculus.</description>
    <tab>ET</tab>
    <prerequisites>
      <li>D_Dodule</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>200</baseCost>
    <techLevel>Ultra</techLevel>
    <researchViewX>2</researchViewX>
    <researchViewY>2.10</researchViewY>
  </ResearchProjectDef>

  <!-- Tier5 | 花费6000 | 需要CT+AT+ET三个分支 | 解锁高级设备 -->
  <ResearchProjectDef>
    <defName>ET_device</defName>
    <label>ET.Advanced technology</label>
    <description>Development of ET.control device.</description>
    <tab>ET</tab>
    <prerequisites>
      <li>CT_Module</li>
      <li>AT_Module</li>
      <li>ET_Module</li>
    </prerequisites>
    <requiredResearchBuilding>HiTechResearchBench</requiredResearchBuilding>
    <requiredResearchFacilities>
      <li>MultiAnalyzer</li>
    </requiredResearchFacilities>
    <baseCost>6000</baseCost>
    <techLevel>Ultra</techLevel>
    <researchViewX>3</researchViewX>
    <researchViewY>1.40</researchViewY>
  </ResearchProjectDef>

</Defs>
