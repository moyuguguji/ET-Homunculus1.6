<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- ==================== 治愈 ==================== -->
  <!-- 效果等同于治愈机械液 / 水灵自带 / 贴近使用 冷却1天 -->
  <AbilityDef ParentName="AbilityTouchBase">
    <defName>HO_Heal</defName>
    <label>heal</label>
    <description>Heal a permanent injury or restore a missing body part.</description>
    <iconPath>Things/Pawn/Animal/Apparel/HO_Ex_module</iconPath>
    <hostile>false</hostile>
    <cooldownTicksRange>60000</cooldownTicksRange>
    <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
    <verbProperties>
      <verbClass>Verb_CastAbilityTouch</verbClass>
      <warmupTime>2</warmupTime>
      <range>-1</range>
      <targetParams>
        <canTargetPawns>true</canTargetPawns>
        <canTargetLocations>false</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ET_Homunculus.CompProperties_AbilityHeal" />
    </comps>
  </AbilityDef>

  <!-- ==================== 跳跃 ==================== -->
  <!-- 范围:28 / 预热:1.2s / CT.Jump植入物授予 -->
  <AbilityDef>
    <defName>HO_Jump</defName>
    <label>jump</label>
    <description>Jump to a target location within range.</description>
    <iconPath>Things/Projectile/ETR2</iconPath>
    <hostile>false</hostile>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>1.2</warmupTime>    <!-- 预热 -->
      <range>28</range>                 <!-- 射程 -->
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
        <canTargetPawns>false</canTargetPawns>
        <canTargetBuildings>false</canTargetBuildings>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ET_Homunculus.CompProperties_AbilityJump">
        <range>28</range>
      </li>
    </comps>
  </AbilityDef>

  <!-- ==================== ET.Pulse | EMP脉冲 ==================== -->
  <!-- 范围:29.9 / 预热:0.6s / CD:2000(33s) / 弹丸:Bullet_ET_Pulse(EMP半径3.4) / Nymph+Naiad -->
  <AbilityDef>
    <defName>ET_Bolt</defName>
    <label>ET.Pulse</label>
    <description>Fire an EMP pulse that stuns mechanoids.</description>
    <iconPath>Things/Projectile/ET_Bolt</iconPath>
    <cooldownTicksRange>1800</cooldownTicksRange>
    <verbProperties>
      <verbClass>Verb_CastAbility</verbClass>
      <warmupTime>0.6</warmupTime>
      <range>29.9</range>
      <targetParams>
        <canTargetLocations>true</canTargetLocations>
      </targetParams>
    </verbProperties>
    <comps>
      <li Class="ET_Homunculus.CompProperties_LaunchProjectile">
        <projectileDef>Bullet_ET_Pulse</projectileDef>
      </li>
    </comps>
  </AbilityDef>

